# ============================================================
# RAGI Frontend — Politeknik Indonusa
# Salin ke .env.local atau isi di Vercel Project Settings.
# Variabel NEXT_PUBLIC_* dibundel ke client; jangan isi dengan secret.
# ============================================================

# Identitas aplikasi
NEXT_PUBLIC_APP_NAME="RAGI Politeknik Indonusa"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Backend API — pastikan host sesuai deployment backend yang aktif
NEXT_PUBLIC_API_BASE_URL="https://ragibe.poltekindonusa.ac.id/api"
NEXT_PUBLIC_API_URL="https://ragibe.poltekindonusa.ac.id"
NEXT_PUBLIC_BACKEND_URL="https://ragibe.poltekindonusa.ac.id"

# Root domain untuk routing subdomain modul (tanpa scheme/path)
TENANT_BASE_DOMAINS="poltekindonusa.ac.id"
NEXT_PUBLIC_BASE_DOMAINS="poltekindonusa.ac.id"
TENANT_RESERVED_SUBDOMAINS="sso,www,api,mail,webmail,ftp,cloudflare,ragife,ragibe,localhost,demo-sso,demo"

# Opsional: Edge Config untuk tenant_config; EDGE_CONFIG berisi credential baca
EDGE_CONFIG=""
EDGE_CONFIG_ID=""

# Opsional: diperlukan hanya untuk administrasi domain melalui /api/domains
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
DOMAINS_ADMIN_SECRET=""

# Opsional: site key publik Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAFDe9OQ_gTqiMMIX"

# Edge Config tenant_config mendukung baseDomains, reservedSubdomains,
# domainMap, dan enabledModules. Domain/DNS tetap harus ditambahkan terpisah
# di dashboard Vercel dan provider DNS. Lihat docs/vercel-multi-tenant.md.
# Pastikan URL API di atas sesuai backend; fallback kode menunjuk ke localhost.
# Jangan pernah menyimpan secret key Turnstile, VERCEL_TOKEN, EDGE_CONFIG,
# atau DOMAINS_ADMIN_SECRET pada variabel NEXT_PUBLIC_*.
